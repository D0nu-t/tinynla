    {
      "name": "gui-rl2",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "nla.gui",
        "--no-browser",
        "--port",
        "8003",
        "--set",
        "rl.save_dir=checkpoints/gpt2_small_L8/rl2"
      ],
      "port": 8003
